{
  "label": {
    "name": "Socks On Records",
    "established": 2021,
    "tagline": "DIY Label based in the east of England.",
    "about": "What makes DIY music (in any form) so good is the social side of it. We all need to work together to help each other. Your mates band, your mates mates band. We all need help. The idea behind Socks On, is to bring together a group of like minded DIY bands and musicians, to get as much recognition as possible for each band on here. Totally Non-Profit.",
    "compilation_blurb": "Socks On Records exists to be a home for likeminded DIY punk/alternative bands who appreciate the importance of community, sharing, kindness....and not being a dick.",
    "locations": [
      "Peterborough",
      "King's Lynn, Norfolk"
    ],
    "email": "socksonrecords@gmail.com",
